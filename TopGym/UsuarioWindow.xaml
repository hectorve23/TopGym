<Window x:Class="TopGym.UsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopGym - Panel de Usuario" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Background="#FF0C5639" Grid.Column="0">
            <StackPanel VerticalAlignment="Top" Margin="0,30,0,0">
                <TextBlock Text="TopGym" FontSize="24" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtBienvenida" FontSize="13" Foreground="#FFAAD4C8"
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="Actividades" Height="50" Margin="10,5"
                        Background="#FF167751" Foreground="White" BorderThickness="0"
                        FontSize="14" Click="VerActividades_Click"/>

                <Button Content="Planes de entrenamiento" Height="50" Margin="10,5"
                        Background="#FF167751" Foreground="White" BorderThickness="0"
                        FontSize="14" Click="VerPlanes_Click"/>

                <Button Content="Cerrar sesion" Height="50" Margin="10,80,10,5"
                        Background="#FF8B0000" Foreground="White" BorderThickness="0"
                        FontSize="14" Click="CerrarSesion_Click"/>
            </StackPanel>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1" Background="#FFF4F4F4">

            <!-- PANEL ACTIVIDADES -->
            <StackPanel x:Name="panelActividades" Margin="20" Visibility="Visible">
                <TextBlock Text="Actividades dirigidas" FontSize="22" FontWeight="Bold"
                           Foreground="#FF0C5639" Margin="0,0,0,15"/>

                <DataGrid x:Name="dgActividades" AutoGenerateColumns="False" IsReadOnly="True"
                          Height="320" Margin="0,0,0,15" CanUserResizeRows="False"
                          SelectionMode="Single" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Actividad" Binding="{Binding Nombre}" Width="150"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="200"/>
                        <DataGridTextColumn Header="Horario" Binding="{Binding Horario}" Width="120"/>
                        <DataGridTextColumn Header="Plazas libres" Binding="{Binding PlazasLibres}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Apuntarme" Height="40" Width="150" Margin="0,0,10,0"
                            Background="#FF167751" Foreground="White" BorderThickness="0"
                            FontSize="13" Click="Apuntarme_Click"/>
                    <Button Content="Darme de baja" Height="40" Width="150"
                            Background="#FF8B0000" Foreground="White" BorderThickness="0"
                            FontSize="13" Click="DarmeDeBaja_Click"/>
                </StackPanel>

                <TextBlock Text="Mis actividades:" FontSize="16" FontWeight="Bold"
                           Foreground="#FF0C5639" Margin="0,20,0,8"/>
                <ListBox x:Name="lstMisActividades" Height="100"/>
            </StackPanel>

            <!-- PANEL PLANES -->
            <StackPanel x:Name="panelPlanes" Margin="20" Visibility="Collapsed">
                <TextBlock Text="Planes de entrenamiento" FontSize="22" FontWeight="Bold"
                           Foreground="#FF0C5639" Margin="0,0,0,15"/>

                <ComboBox x:Name="cmbCategoria" Height="35" FontSize="13" Margin="0,0,0,15"
                          SelectionChanged="CmbCategoria_SelectionChanged"/>

                <ListBox x:Name="lstPlanes" Height="380" FontSize="13"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
