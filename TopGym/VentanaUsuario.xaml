<Window x:Class="TopGym.VentanaUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TopGym"
        mc:Ignorable="d"
        Title="TopGym - Mi Panel" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Boton principal verde -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF167751"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0C5639"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton rojo para darse de baja -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MainButtonStyle}">
            <Setter Property="Background" Value="#BF1C1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B0000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boton azul informativo -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MainButtonStyle}">
            <Setter Property="Background" Value="#2E7D9A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A5F7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- Cabecera de seccion -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- DataGrid base -->
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F0FFF8"/>
            <Setter Property="BorderBrush" Value="#FF167751"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
        </Style>

        <!-- Estilo cabecera DataGrid verde oscuro -->
        <Style x:Key="DarkHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF0C5639"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Estilo cabecera DataGrid verde medio -->
        <Style x:Key="MidHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF167751"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Tarjeta de plan de entrenamiento -->
        <Style x:Key="PlanCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="6" ShadowDepth="2" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Placeholder simulado con Tag -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#FF167751"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush TileMode="None" Stretch="None" AlignmentX="Left" AlignmentY="Center">
                                <VisualBrush.Visual>
                                    <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="10,0,0,0"
                                               Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TextBox}}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--SIDEBAR-->
        <Border Background="#FF0C5639" Grid.Column="0">
            <DockPanel>

                <!-- Logo y datos del usuario -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,20">
                    <Image Source="/img/logo.png" Height="65" Stretch="Uniform" Margin="0,0,0,12"/>
                    <TextBlock Text="TopGym" FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <Separator Background="#FF167751" Margin="0,12,0,12"/>
                    <!-- Avatar circular -->
                    <Border Width="64" Height="64" CornerRadius="32"
                            HorizontalAlignment="Center" Margin="0,0,0,8"
                            Background="#FF167751">
                        <TextBlock x:Name="TxtInicialUsuario" Text="U"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtNombreUsuario" Text="Nombre Usuario"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="TxtEmailUsuario" Text="email@ejemplo.com"
                               FontSize="11" Foreground="#AAFFFFFF"
                               HorizontalAlignment="Center" Margin="0,2,0,0"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Navegacion -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0">
                    <Button Content="🏠  Inicio"
                            Style="{StaticResource MainButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"
                            Click="NavInicio_Click"/>
                    <Button Content="🏋  Actividades"
                            Style="{StaticResource MainButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"
                            Click="NavActividades_Click"/>
                    <Button Content="📋  Planes de entrenamiento"
                            Style="{StaticResource MainButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"
                            Click="NavPlanes_Click"/>
                    <Button Content="👤  Mi perfil"
                            Style="{StaticResource MainButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Padding="14,0"
                            Click="NavPerfil_Click"/>
                </StackPanel>

                <!-- Cerrar sesion -->
                <Button DockPanel.Dock="Bottom"
                        Content="⬅  Cerrar sesión"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="12,0,12,20"
                        HorizontalContentAlignment="Left"
                        Padding="14,0"
                        Click="CerrarSesion_Click"/>
            </DockPanel>
        </Border>

        <!--CONTENIDO-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Background="#FF167751" Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                    <TextBlock x:Name="PageTitle" Text="Inicio"
                               FontSize="22" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- TabControl sin cabeceras visibles (navegación desde sidebar) -->
            <TabControl Grid.Row="1" x:Name="MainTabControl"
                        Background="#FFF5F5F5"
                        BorderThickness="0">

                <TabControl.Resources>
                    <!-- Ocultar las pestañas del TabControl, la navegación es por sidebar -->
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 0: INICIO / RESUMEN  -->
                <TabItem x:Name="TabInicio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">

                            <TextBlock Text="¡Bienvenido a TopGym!" FontSize="22"
                                       FontWeight="Bold" Foreground="#FF0C5639" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSaludo"
                                       Text="Aquí tienes un resumen de tu actividad."
                                       FontSize="13" Foreground="#555555" Margin="0,0,0,20"/>

                            <!-- Tarjetas resumen -->
                            <UniformGrid Rows="1" Margin="0,0,0,20">
                                <Border Background="#FF167751" CornerRadius="10"
                                        Margin="0,0,8,0" Padding="20,14">
                                    <StackPanel>
                                        <TextBlock Text="Actividades inscritas"
                                                   Foreground="#CCFFFFFF" FontSize="12"/>
                                        <TextBlock x:Name="CardActividadesInscritas" Text="0"
                                                   Foreground="White" FontSize="36" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FF0C5639" CornerRadius="10"
                                        Margin="4,0,4,0" Padding="20,14">
                                    <StackPanel>
                                        <TextBlock Text="Próxima sesión"
                                                   Foreground="#CCFFFFFF" FontSize="12"/>
                                        <TextBlock x:Name="CardProximaSesion" Text="—"
                                                   Foreground="White" FontSize="18" FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#2E7D9A" CornerRadius="10"
                                        Margin="8,0,0,0" Padding="20,14">
                                    <StackPanel>
                                        <TextBlock Text="Plan activo"
                                                   Foreground="#CCFFFFFF" FontSize="12"/>
                                        <TextBlock x:Name="CardPlanActivo" Text="—"
                                                   Foreground="White" FontSize="18" FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Mis actividades-->
                            <TextBlock Text="Mis actividades inscritas"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#FF0C5639" Margin="0,0,0,10"/>
                            <Border Background="White" CornerRadius="10" Padding="16">
                                <DataGrid x:Name="DgMisActividadesResumen"
                                          Style="{StaticResource GridStyle}"
                                          MaxHeight="180">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource MidHeaderStyle}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Actividad"  Binding="{Binding Nombre}"    Width="*"/>
                                        <DataGridTextColumn Header="Monitor"    Binding="{Binding Monitor}"   Width="140"/>
                                        <DataGridTextColumn Header="Horario"    Binding="{Binding Horario}"   Width="160"/>
                                        <DataGridTextColumn Header="Categoría"  Binding="{Binding Categoria}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 1: ACTIVIDADES       -->
                <TabItem x:Name="TabActividades">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tabla de actividades disponibles -->
                        <Border Background="White" CornerRadius="10"
                                Padding="16" Grid.Column="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="Actividades disponibles"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="#FF0C5639"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBuscarActividad"
                                             Width="200" Height="30"
                                             Margin="20,0,0,0" Padding="8,4"
                                             FontSize="12"
                                             BorderBrush="#FF167751" BorderThickness="2"
                                             Style="{StaticResource InputStyle}"
                                             Tag="🔍  Buscar actividad..."
                                             TextChanged="BuscarActividad_TextChanged"/>
                                    <ComboBox x:Name="CmbFiltroCategoria"
                                              Width="140" Height="30" Margin="10,0,0,0"
                                              FontSize="12"
                                              BorderBrush="#FF167751" BorderThickness="2"
                                              SelectionChanged="FiltroCategoria_Changed">
                                        <ComboBoxItem Content="Todas las categorías" IsSelected="True"/>
                                        <ComboBoxItem Content="Cardio"/>
                                        <ComboBoxItem Content="Fuerza"/>
                                        <ComboBoxItem Content="Flexibilidad"/>
                                        <ComboBoxItem Content="Mente y cuerpo"/>
                                        <ComboBoxItem Content="Aqua fitness"/>
                                    </ComboBox>
                                </StackPanel>

                                <DataGrid x:Name="DgActividadesDisponibles"
                                          Style="{StaticResource GridStyle}"
                                          SelectionChanged="DgActividades_SelectionChanged">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource DarkHeaderStyle}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Actividad"   Binding="{Binding Nombre}"      Width="*"/>
                                        <DataGridTextColumn Header="Monitor"     Binding="{Binding Monitor}"     Width="130"/>
                                        <DataGridTextColumn Header="Categoría"   Binding="{Binding Categoria}"   Width="110"/>
                                        <DataGridTextColumn Header="Horario"     Binding="{Binding Horario}"     Width="160"/>
                                        <DataGridTextColumn Header="Plazas"      Binding="{Binding PlazasLibres}" Width="70"/>
                                        <!-- Columna de estado de plaza -->
                                        <DataGridTemplateColumn Header="Estado" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FF167751"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PlazasLibres}" Value="0">
                                                                        <Setter Property="Background" Value="#BF1C1C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Disponible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PlazasLibres}" Value="0">
                                                                            <Setter Property="Text" Value="Completa"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Panel lateral: detalle y accion -->
                        <Border Background="#FF0C5639" CornerRadius="10"
                                Padding="20" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="Detalle de la actividad"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator Background="#FF167751" Margin="0,0,0,14"/>

                                <!-- Info de la actividad seleccionada -->
                                <TextBlock Text="Nombre" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="DetNombre" Text="—"
                                           Foreground="White" FontSize="15" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Descripción" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="DetDescripcion" Text="—"
                                           Foreground="#DDFFFFFF" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Monitor" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="DetMonitor" Text="—"
                                           Foreground="White" FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Text="Horario" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="DetHorario" Text="—"
                                           Foreground="White" FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Text="Categoría" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="DetCategoria" Text="—"
                                           Foreground="White" FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Text="Plazas disponibles" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="DetPlazas" Text="—"
                                           Foreground="White" FontSize="20" FontWeight="Bold"
                                           Margin="0,0,0,8"/>

                                <Separator Background="#FF167751" Margin="0,10,0,14"/>

                                <!-- Boton inscribirse -->
                                <Button x:Name="BtnInscribirse"
                                        Content="✚  Inscribirme en esta actividad"
                                        Style="{StaticResource MainButtonStyle}"
                                        Background="#1D6A2E"
                                        IsEnabled="False"
                                        Click="Inscribirse_Click"/>

                                <!-- Boton darse de baja -->
                                <Button x:Name="BtnDarseDeBaja"
                                        Content="✖  Darme de baja"
                                        Style="{StaticResource DangerButtonStyle}"
                                        IsEnabled="False"
                                        Click="DarseDeBaja_Click"/>

                                <Separator Background="#FF167751" Margin="0,14,0,10"/>

                                <!-- Mis inscripciones actuales -->
                                <TextBlock Text="Mis inscripciones activas"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           FontSize="14"/>
                                <Border Background="#FF167751" CornerRadius="8" Padding="10">
                                    <ListBox x:Name="LstMisInscripciones"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MaxHeight="150"
                                             Foreground="White"
                                             FontSize="12">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Nombre}"
                                                           Foreground="White"
                                                           Padding="2,3"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: PLANES DE ENTRENAMIENTO   -->
                <TabItem x:Name="TabPlanes">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel izquierdo: lista de planes -->
                        <Border Background="#FF0C5639" CornerRadius="10"
                                Padding="16" Grid.Column="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Planes disponibles"
                                           Style="{StaticResource SectionHeaderStyle}"/>
                                <Separator DockPanel.Dock="Top"
                                           Background="#FF167751" Margin="0,0,0,12"/>
                                <TextBox DockPanel.Dock="Top"
                                         x:Name="TxtBuscarPlan"
                                         Style="{StaticResource InputStyle}"
                                         Tag="🔍  Buscar plan..."
                                         TextChanged="BuscarPlan_TextChanged"/>

                                <ListBox x:Name="LstPlanes"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="0,8,0,0"
                                         SelectionChanged="LstPlanes_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,10"/>
                                            <Setter Property="Margin" Value="0,3"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="#FF167751"
                                                                CornerRadius="7"
                                                                Padding="12,10"
                                                                Margin="0,3">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="Background" Value="#1D6A2E"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder"
                                                                        Property="Background" Value="#0E7040"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nombre}"
                                                           Foreground="White"
                                                           FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding Nivel}"
                                                           Foreground="#AAFFFFFF" FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Panel derecho: detalle del plan -->
                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelDetallePlan">

                                <!-- Cabecera del plan -->
                                <Border Background="#FF0C5639" CornerRadius="10"
                                        Padding="20,16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="PlanNombre" Text="Selecciona un plan"
                                                       FontSize="22" FontWeight="Bold"
                                                       Foreground="White"/>
                                            <TextBlock x:Name="PlanDescripcion"
                                                       Text="Elige un plan de la lista para ver sus detalles."
                                                       FontSize="13" Foreground="#CCFFFFFF"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <!-- Badge de nivel -->
                                        <Border Grid.Column="1"
                                                CornerRadius="8" Padding="12,6"
                                                VerticalAlignment="Top" Margin="16,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2E7D9A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=PlanNivel, Path=Text}" Value="Avanzado">
                                                            <Setter Property="Background" Value="#BF1C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ElementName=PlanNivel, Path=Text}" Value="Intermedio">
                                                            <Setter Property="Background" Value="#B8750A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="PlanNivel" Text="—"
                                                       Foreground="White"
                                                       FontWeight="Bold" FontSize="13"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Datos rápidos -->
                                <UniformGrid Rows="1" Margin="0,0,0,12">
                                    <Border Background="White" CornerRadius="10"
                                            Padding="14,12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Duración" FontSize="11"
                                                       Foreground="#888888"/>
                                            <TextBlock x:Name="PlanDuracion" Text="—"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="#FF0C5639"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White" CornerRadius="10"
                                            Padding="14,12" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="Sesiones / semana" FontSize="11"
                                                       Foreground="#888888"/>
                                            <TextBlock x:Name="PlanSesiones" Text="—"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="#FF0C5639"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White" CornerRadius="10"
                                            Padding="14,12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Objetivo" FontSize="11"
                                                       Foreground="#888888"/>
                                            <TextBlock x:Name="PlanObjetivo" Text="—"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="#FF0C5639"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Tabla de ejercicios del plan -->
                                <Border Background="White" CornerRadius="10"
                                        Padding="16" Margin="0,0,0,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="Ejercicios del plan"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#FF0C5639"
                                                   Margin="0,0,0,10"/>
                                        <DataGrid x:Name="DgEjercicios"
                                                  Style="{StaticResource GridStyle}"
                                                  MaxHeight="220">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader"
                                                       BasedOn="{StaticResource DarkHeaderStyle}"/>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Día"        Binding="{Binding Dia}"         Width="70"/>
                                                <DataGridTextColumn Header="Ejercicio"  Binding="{Binding Ejercicio}"   Width="*"/>
                                                <DataGridTextColumn Header="Series"     Binding="{Binding Series}"      Width="65"/>
                                                <DataGridTextColumn Header="Reps"       Binding="{Binding Repeticiones}" Width="65"/>
                                                <DataGridTextColumn Header="Descanso"   Binding="{Binding Descanso}"    Width="80"/>
                                                <DataGridTextColumn Header="Notas"      Binding="{Binding Notas}"       Width="130"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <!-- Recomendaciones nutricionales -->
                                <Border Background="White" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Recomendaciones del plan"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#FF0C5639"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock x:Name="PlanRecomendaciones"
                                                   Text="Selecciona un plan para ver sus recomendaciones."
                                                   FontSize="13" Foreground="#444444"
                                                   TextWrapping="Wrap" LineHeight="20"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>


                <!-- TAB 3: MI PERFIL-->
                <TabItem x:Name="TabPerfil">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel datos personales -->
                        <Border Background="#FF0C5639" CornerRadius="10"
                                Padding="24" Grid.Column="0">
                            <StackPanel>
                                <!-- Avatar -->
                                <Border Width="80" Height="80" CornerRadius="40"
                                        HorizontalAlignment="Center"
                                        Background="#FF167751" Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtInicialPerfil" Text="U"
                                               FontSize="36" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Mis datos"
                                           Style="{StaticResource SectionHeaderStyle}"
                                           FontSize="18" HorizontalAlignment="Center"
                                           Margin="0,0,0,14"/>
                                <Separator Background="#FF167751" Margin="0,0,0,14"/>

                                <TextBlock Text="Nombre" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtPerfilNombre"
                                         Style="{StaticResource InputStyle}"
                                         Tag="Tu nombre"/>

                                <TextBlock Text="Apellidos" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtPerfilApellidos"
                                         Style="{StaticResource InputStyle}"
                                         Tag="Tus apellidos"/>

                                <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtPerfilEmail"
                                         Style="{StaticResource InputStyle}"
                                         Tag="tu@email.com"/>

                                <TextBlock Text="Teléfono" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtPerfilTelefono"
                                         Style="{StaticResource InputStyle}"
                                         Tag="Número de teléfono"/>

                                <TextBlock Text="Nueva contraseña" Style="{StaticResource LabelStyle}"/>
                                <PasswordBox x:Name="PwdNuevaContrasena"
                                             Height="32" Margin="0,4,0,4"
                                             Padding="8,4" FontSize="13"
                                             BorderBrush="#FF167751" BorderThickness="2"/>

                                <Separator Background="#FF167751" Margin="0,14,0,10"/>

                                <Button Content="💾  Guardar cambios"
                                        Style="{StaticResource MainButtonStyle}"
                                        Click="GuardarPerfil_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Panel historial de actividades -->
                        <Border Background="White" CornerRadius="10"
                                Padding="16" Grid.Column="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Mis actividades inscritas"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#FF0C5639" Margin="0,0,0,12"/>

                                <DataGrid x:Name="DgMisActividades"
                                          Style="{StaticResource GridStyle}">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource MidHeaderStyle}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Actividad"  Binding="{Binding Nombre}"      Width="*"/>
                                        <DataGridTextColumn Header="Monitor"    Binding="{Binding Monitor}"     Width="130"/>
                                        <DataGridTextColumn Header="Horario"    Binding="{Binding Horario}"     Width="160"/>
                                        <DataGridTextColumn Header="Categoría"  Binding="{Binding Categoria}"   Width="110"/>
                                        <DataGridTemplateColumn Header="Acción" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Darme de baja"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Height="28" Margin="4,2"
                                                            FontSize="11"
                                                            Click="DarseDeBaja_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>