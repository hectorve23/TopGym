<Window x:Class="TopGym.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TopGym"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="61*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="367*"/>
            <RowDefinition Height="67*"/>
        </Grid.RowDefinitions>
        <Border Background="#FF0C5639">
            <Image Margin="0,20,10,22" Source="/img/logo.png" Stretch="Fill"/>
        </Border>
        <Border Background="#FF167751" Grid.Column="1">
            <StackPanel Margin="54,0,0,0" VerticalAlignment="Center" Height="320" Orientation="Vertical">
                <TextBlock Text="Iniciar sesión" FontSize="25" Style="{StaticResource HeaderStyle}" Margin="0,0,0,20"/>

                <TextBlock Text="Usuario" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsuario" Width="200" Height="35" Margin="0,0,90,15" Padding="5"/>

                <TextBlock Text="Contraseña" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Width="200" Height="35" Margin="0,0,90,20" Padding="5"/>

                <Button Content="Iniciar sesión" Width="164" Height="42" Margin="0,0,90,10" Click="IniciarSesion_Click"/>
                <Button Content="Registrarse" Width="159" Height="42" Margin="0,0,90,0" Click="Registro_Click"/>
            </StackPanel>
        </Border>
        <Border Background="#FF167751" Grid.Row="1" Grid.ColumnSpan="2">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Tu gimnasio, cerca de ti" FontSize="25" Style="{StaticResource HeaderStyle}">
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
