<Window x:Class="TopGym.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TopGym"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="61*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="367*"/>
            <RowDefinition Height="67*"/>
        </Grid.RowDefinitions>
        <Border Background="#FF0C5639">
            <Image Margin="0,20,10,22" Source="/img/logo.png" Stretch="Fill"/>
        </Border>
        <Border Background="#FF167751" Grid.Column="1">
            <StackPanel Margin="54,0,0,0" VerticalAlignment="Center" Height="285" Orientation="Vertical" >
                <TextBlock Text="Iniciar sesion" FontSize="25" Foreground="White" Style="{StaticResource HeaderStyle}"/>
                <Button Content="Registrarse" Margin="0,80,90,20" Height="37" Width="128" Click="Registro_Click"/>
                <Button Content="Iniciar sesión" Margin="0,0,90,0" Height="57" Width="287" Click="IniciarSesion_Click"/>
            </StackPanel>
        </Border>
        <Border Background="#FF167751" Grid.Row="1" Grid.ColumnSpan="2">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Tu gimnasio, cerca de ti" FontSize="25" Foreground="White" Style="{StaticResource HeaderStyle}">
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
