<Window x:Class="TopGym.RegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de usuario" Height="450" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Background="#FF0C5639">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

            <TextBlock Text="Crear cuenta" FontSize="28" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Nombre de usuario" Foreground="White" FontSize="13" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNombre" Height="35" Padding="8,5" Margin="0,0,0,15" FontSize="13"/>

            <TextBlock Text="Contraseña" Foreground="White" FontSize="13" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="35" Padding="8,5" Margin="0,0,0,15" FontSize="13"/>

            <TextBlock Text="Confirmar contraseña" Foreground="White" FontSize="13" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtConfirmar" Height="35" Padding="8,5" Margin="0,0,0,25" FontSize="13"/>

            <Button Content="Crear cuenta" Height="45" FontSize="14" Margin="0,0,0,10"
                    Background="#FF167751" Foreground="White" BorderThickness="0"
                    Click="CrearCuenta_Click"/>

            <Button Content="Cancelar" Height="40" FontSize="13"
                    Background="Transparent" Foreground="White" BorderThickness="1" BorderBrush="White"
                    Click="Cancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
